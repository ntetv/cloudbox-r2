{
	"name": "cloudbox-r2-root",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"lint": "biome check src packages/dashboard/client packages/dashboard/scripts packages/worker/src packages/worker/scripts/build-package.mjs scripts/*.mjs tests/install_cloudbox-launcher.test.mjs",
		"lint:posix": "sh -n install_cloudbox.sh && pnpm lint",
		"build-dashboard": "pnpm run --filter ./packages/dashboard build",
		"build-worker": "pnpm run --filter ./packages/worker build",
		"build": "pnpm build-dashboard && pnpm build-worker",
		"build:artifact": "node scripts/build_cloudbox_artifact.mjs",
		"embed:artifact": "node scripts/embed_cloudbox_artifact.mjs",
		"build:deployer": "node scripts/build_cloudbox_deployer.mjs",
		"test:posix-launcher": "sh -n install_cloudbox.sh && node --test tests/install_cloudbox-launcher.test.mjs",
		"dev": "pnpm build-dashboard && pnpm --filter ./packages/worker exec wrangler dev --config ../../wrangler.toml",
		"publint": "pnpm --filter ./packages/worker publint",
		"package": "pnpm run --filter ./packages/worker package"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4"
	}
}
